# Anthropic API Key (required) - Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OS Security Key (required)
OS_SECURITY_KEY=omnigpt

# Port for the server (optional, default: 8000)
PORT=8000

# ============================================================
# MCP (Model Context Protocol) Server Tokens
# ============================================================

# GitHub Personal Access Token
# Required for: Creating repos, reading/writing files, storing workflow outputs
# Get yours from: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=your-github-personal-access-token-here

# Supabase Access Token (Optional - only if using Supabase features)
# Get yours from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# Vercel Token (Optional - only if using Vercel deployment features)
# Get yours from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Google OAuth Credentials (required for Google Docs integration)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Supabase PostgreSQL Database (required for all agents, teams, and workflows)
# Option 1: Direct connection URL (preferred)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
# Option 2: Project credentials (SUPABASE_DB_URL is constructed automatically)
# SUPABASE_PROJECT=your-supabase-project-ref
# SUPABASE_PASSWORD=your-supabase-db-password
