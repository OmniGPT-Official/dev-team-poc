# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port for the server (optional, default: 8000)
PORT=8000

# ============================================================================
# AI MODEL KEYS
# ============================================================================

# Anthropic Claude API (for Claude models)
ANTHROPIC_API_KEY='sk-ant-api03-xxxxx'

# OpenRouter API (for multi-model access - using Gemini Flash)
OPENROUTER_API_KEY='sk-or-v1-xxxxx'

# Moonshot AI API (for Kimi models - Software Engineer)
# Get yours from: https://platform.moonshot.cn
MOONSHOT_API_KEY='your-moonshot-api-key-here'

# ElevenLabs API Key (Optional - only if using ElevenLabs calling features)
# Get yours from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Google AI API Key (required for Nano Banana Pro image generation in Content Team)
# Get yours from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Google OAuth Credentials (required for Gmail + Google Sheets integration)
# Get these from: https://console.cloud.google.com/apis/credentials
# Built-in token generator available at: http://localhost:8000/google-auth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Get your connection string from Supabase Dashboard:
# 1. Go to: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
# 2. Scroll to "Connection string" section
# 3. Choose "Session pooler" (RECOMMENDED)
# 4. Copy the connection string
# 5. Replace [YOUR-PASSWORD] with your actual database password

# Session Pooler (Port 5432) - RECOMMENDED for Agno/SQLAlchemy
DATABASE_URL='postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres'

# OR Transaction Pooler (Port 6543) - for serverless/edge functions
# DATABASE_URL='postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true'

# OR Direct Connection (Port 5432) - no pooling
# DATABASE_URL='postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres'

# Supabase PostgreSQL Database (legacy/fallback if DATABASE_URL not set)
SUPABASE_DB_URL='postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres'

# Supabase API (required for per-user credential storage)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL='https://your-project.supabase.co'
SUPABASE_SERVICE_ROLE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx'

# ============================================================================
# INSTAGRAM / META OAUTH (required for Instagram Agent)
# ============================================================================

# Get these from: https://developers.facebook.com/apps/ > Your App > App Settings > Basic
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here

# The OAuth callback URL — points to your deployed instagram-callback Supabase edge function
META_REDIRECT_URI=https://your-project.supabase.co/functions/v1/instagram-callback

# Supabase Storage (required for posting user-attached images to Instagram)
# Can be the same as SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above
SUPABASE_STORAGE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# NOTE: META_APP_ID, META_APP_SECRET, and META_REDIRECT_URI must also be set
# as secrets on the instagram-callback Supabase Edge Function.

# ============================================================
# BROWSERBASE (required for HR Job Poster browser automation)
# ============================================================
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ============================================================================
# EXTERNAL SERVICES (Optional - Fallback only)
# ============================================================================

# NOTE: GitHub, Vercel, and Supabase tokens are now stored PER-USER in the database.
# These env vars serve as fallbacks for local development only.

# For GitHub operations (fallback if no per-user token in DB)
# GITHUB_TOKEN='ghp_xxxxx'

# For Vercel deployments (fallback if no per-user token in DB)
# VERCEL_TOKEN='xxxxx'

# For Supabase MCP tools (fallback if no per-user token in DB)
# SUPABASE_ACCESS_TOKEN='sbp_xxxxx'

# ============================================================================
# NOTES
# ============================================================================

# Per-User Credential Storage:
# - GitHub tokens: stored in user_api_keys table (provider='github')
# - Vercel tokens: stored in user_api_keys table (provider='vercel')
# - Supabase tokens: stored in user_api_keys table (provider='supabase')
# - ElevenLabs keys: stored in user_api_keys table (provider='elevenlabs')
# - Google OAuth: stored in user_oauth_connections table (provider='google_sheets', 'google_gmail')
# - Instagram OAuth: stored in user_oauth_connections table (provider='instagram', metadata includes ig_user_id)

# To add a user's GitHub token to the database:
# INSERT INTO user_api_keys (user_id, provider, api_key)
# VALUES ('user-id-here', 'github', 'ghp_xxxxx');
